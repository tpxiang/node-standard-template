// Prisma schema（MySQL 分支）
// 说明：与 main 业务模型保持一致，仅 datasource.provider 与 migration 方言不同。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 用户状态：ACTIVE 可登录；INACTIVE/LOCKED 拒绝登录。
enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum TenantMemberStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  status    TenantStatus   @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  members   TenantMember[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("tenants")
}

/// 系统用户。
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  roles         UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  refreshTokens RefreshToken[]
  tenantMembers TenantMember[]

  @@map("users")
}

model TenantMember {
  id        String             @id @default(cuid())
  tenantId  String             @map("tenant_id")
  userId    String             @map("user_id")
  status    TenantMemberStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     TenantMemberRole[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenant_members")
}

model TenantMemberRole {
  memberId  String       @map("member_id")
  roleId    String       @map("role_id")
  createdAt DateTime     @default(now()) @map("created_at")
  member    TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("tenant_member_roles")
}

/// 刷新令牌会话：库中只存 hash；revokedAt 非空表示已吊销。
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// RBAC 角色。
model Role {
  id            String             @id @default(cuid())
  tenantId      String             @default("tenant_default") @map("tenant_id")
  name          String
  description   String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  users         UserRole[]
  permissions   RolePermission[]
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantMembers TenantMemberRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

/// 权限码，例如 user:read / role:write。
model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// 审计日志：记录关键业务动作，便于追溯。
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @default("tenant_default") @map("tenant_id")
  actorId    String?  @map("actor_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
